# Copy to .env.local for local development (never commit the real .env file).
# In production, set these in Vercel -> Project Settings -> Environment Variables.

# API key used for writing new tickets to Agilebase (server-side only, never sent to the browser)
AB_TICKETS_API_KEY=

# "test" (default if unset or anything else) or "live". Must be exactly "live" to write to the live instance.
AB_ENVIRONMENT=test
